{
  "manifest_version": 3,
  "name": "Ghandi Product Grabber",
  "version": "1.0.0",
  "description": "Paste product links from brand websites, get all the product data (photos, name, price, specifications) ready to paste into the Ghandi admin.",
  "permissions": ["scripting", "tabs", "storage", "unlimitedStorage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Ghandi Product Grabber",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
